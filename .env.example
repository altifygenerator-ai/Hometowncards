# Store preview. Do not change to true before eBay + checkout + reconciliation are tested.
NEXT_PUBLIC_STORE_LIVE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Private database connection — create a NEW dedicated Supabase project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Reserved for Stripe checkout and webhook development (not active)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# eBay Production seller authorization, on the server only (not connected)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_SYNC_SECRET=
# Seller onboarding stays OFF until Connect and admin moderation are implemented
SELLER_SIGNUPS_ENABLED=false
# Private shopkeeper sign-in uses Supabase Auth with server-verified seller membership.
# No public seller registration routes are enabled. Create the founding owner in Supabase Auth,
# then insert platform_staff + seller_members in the dedicated database.
# APP marketplace mode is OFF in public.marketplace_settings until Connect/checkout testing.
