# PUBLIC STOREFRONT / RELEASE FLAGS
NEXT_PUBLIC_SITE_URL=https://www.hometowncardshop.com
NEXT_PUBLIC_STORE_LIVE=false
SELLER_SIGNUPS_ENABLED=false

# OWNER IDENTITY / MESSAGES
# The verified Auth user with this exact email is the ONLY platform owner.
SHOP_ADMIN_EMAIL=altifygenerator@gmail.com
STORE_ALERT_EMAIL=altifygenerator@gmail.com
STORE_CONTACT_EMAIL=altifygenerator@gmail.com

# DEDICATED SUPABASE PROJECT ONLY (DO NOT SHARE AN EXISTING BUSINESS DATABASE)
SUPABASE_URL=https://wqzidxudbwornpwgnsbj.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://wqzidxudbwornpwgnsbj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy low-privilege key supported during migration only. Never put a secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, use Supabase's new sb_secret_* key. Never prefix with NEXT_PUBLIC_!
SUPABASE_SECRET_KEY=
# Legacy fallback while migrating existing servers only:
SUPABASE_SERVICE_ROLE_KEY=

# CLOUDFLARE TURNSTILE — generate for BOTH production and preview hostnames
# Required for admin login. Missing keys FAIL CLOSED.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OPTIONAL OUTBOUND ALERTS — use a VERIFIED sender domain in Resend.
# No emails are sent until RESEND_API_KEY and RESEND_FROM_EMAIL are configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Hometown Card Shop <orders@hometownwebservicesar.cc>
RESEND_REPLY_TO_EMAIL=altifygenerator@gmail.com

# STRIPE FIRST-PARTY SALES — NOT ACTIVE UNTIL CHECKOUT IS VERIFIED
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# DO NOT configure Connect accounts yet; they will onboard individually.

# EBAY SELLER AUTHORISATION — NOT ACTIVE UNTIL OAUTH IS COMPLETED
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_SYNC_SECRET=
