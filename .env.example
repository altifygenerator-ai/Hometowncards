# PUBLIC STOREFRONT / RELEASE FLAGS
NEXT_PUBLIC_SITE_URL=https://www.hometowncardshop.com
NEXT_PUBLIC_STORE_LIVE=false
SELLER_SIGNUPS_ENABLED=false

# OWNER IDENTITY / MESSAGES
# The verified Auth user with this exact email is the ONLY platform owner.
SHOP_ADMIN_EMAIL=altifygenerator@gmail.com
STORE_ALERT_EMAIL=altifygenerator@gmail.com
STORE_CONTACT_EMAIL=altifygenerator@gmail.com

# DEDICATED SUPABASE PROJECT ONLY (DO NOT SHARE AN EXISTING BUSINESS DATABASE)
SUPABASE_URL=https://wqzidxudbwornpwgnsbj.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://wqzidxudbwornpwgnsbj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy low-privilege key supported during migration only. Never put a secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, use Supabase's new sb_secret_* key. Never prefix with NEXT_PUBLIC_!
SUPABASE_SECRET_KEY=
# Legacy fallback while migrating existing servers only:
SUPABASE_SERVICE_ROLE_KEY=

# CLOUDFLARE TURNSTILE — generate for BOTH production and preview hostnames
# Required for admin login. Missing keys FAIL CLOSED.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OPTIONAL OUTBOUND ALERTS — use a VERIFIED sender domain in Resend.
# No emails are sent until RESEND_API_KEY and RESEND_FROM_EMAIL are configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Hometown Card Shop <orders@hometownwebservicesar.cc>
RESEND_REPLY_TO_EMAIL=altifygenerator@gmail.com

# CHECKOUT / TAX PAID ORDERS
# Actual Stripe payment activation additionally requires NEXT_PUBLIC_CHECKOUT_ENABLED=true,
# STRIPE_CHECKOUT_ENABLED=true and the database marketplace_settings.checkout_enabled=true.
# Tax is calculated in our storefront, not Stripe Tax or ZipTax.
# Official AR SST rate/boundary files are downloaded server-side at checkout.
# Tax calculations fail closed if these files are unavailable or out of quarter.
# For mixed tax-district ZIPs the customer enters their ZIP+4.
# No third-party tax API key is needed.
# Set to true only AFTER the business actually obtains Arkansas sales-tax registration.
# This is a compliance acknowledgement, not a Stripe registration and not a workaround.
ARKANSAS_SALES_TAX_REGISTERED=false
NEXT_PUBLIC_CHECKOUT_ENABLED=false
STRIPE_CHECKOUT_ENABLED=false

# STRIPE FIRST-PARTY SALES — NOT ACTIVE UNTIL CHECKOUT IS VERIFIED
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# DO NOT configure Connect accounts yet; they will onboard individually.

# EBAY SELLER AUTHORISATION — NOT ACTIVE UNTIL OAUTH IS COMPLETED
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_SYNC_SECRET=

# FUTURE SELLER MEMBERSHIPS - currently closed to outside sellers
STRIPE_SELLER_STARTER_PRICE_ID=price_1UPWydDy1ZySXGQNAUMz6MQh
SELLER_MEMBERSHIP_SIGNUPS_ENABLED=false
STRIPE_MEMBERSHIP_TAX_READY=false

# FUTURE STRIPE CONNECT - payments and connected seller tax are separate.
# The seller tax profile can select seller-managed or connected-account Stripe Tax,
# but full Connect marketplace checkout is OFF until payout, tax and webhook tests.
# Stripe Connect does NOT automatically register sellers for taxes.
# FUTURE STRIPE CONNECT - connected account events are verified separately
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_ONBOARDING_ENABLED=false

# OPTIONAL CARD IDENTIFICATION (never expose API key to the browser)
OPENAI_API_KEY=
OPENAI_CARD_MODEL=gpt-4.1-mini
AI_CARD_IDENTIFICATION_ENABLED=false
NEXT_PUBLIC_AI_CARD_TOOLS_ENABLED=false
# This assistant identifies visible card details only. Suggested prices require external sold-sale comparisons.

# FUTURE CARD PRICE RESEARCH. These flags remain FALSE even if provider tokens exist.
CARD_PRICING_LIVE_LOOKUPS_ENABLED=false
CARD_PRICING_APPLY_ENABLED=false
# Only after receiving approved eBay Marketplace Insights access, not ordinary seller OAuth:
EBAY_MARKETPLACE_INSIGHTS_TOKEN=
# Other data sources require their respective licensing / authorized API access:
SPORTSCARDSPRO_API_KEY=
COLLX_DATA_ACCESS_TOKEN=
CARDMARKET_API_KEY=
# OpenAI web research uses OPENAI_API_KEY above; web results are not verified sold receipts.
